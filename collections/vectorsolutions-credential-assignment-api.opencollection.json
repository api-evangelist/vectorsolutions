{
  "opencollection": "1.0.0",
  "info": {
    "name": "TargetSolutions Courses Credential Assignment API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AccessToken",
      "value": "{{AccessToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credential Assignment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a user's credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/users/:userid/credentials",
            "params": [
              {
                "name": "userid",
                "value": "",
                "type": "path",
                "description": "User identifier"
              }
            ]
          },
          "docs": "Retrieve a user's credentials."
        },
        {
          "info": {
            "name": "Retrieve credential assignments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/credentials/:credentialid/assignments",
            "params": [
              {
                "name": "credentialid",
                "value": "",
                "type": "path",
                "description": "Credential identifier"
              }
            ]
          },
          "docs": "Retrieve credential assignments."
        },
        {
          "info": {
            "name": "Create a credential assignment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.targetsolutions.com/v1/credentials/:credentialid/assignments",
            "params": [
              {
                "name": "credentialid",
                "value": "",
                "type": "path",
                "description": "Credential identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a credential assignment."
        },
        {
          "info": {
            "name": "Retrieve a specific credential assignment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/credentials/:credentialid/assignments/:assignmentid",
            "params": [
              {
                "name": "credentialid",
                "value": "",
                "type": "path",
                "description": "Credential identifier"
              },
              {
                "name": "assignmentid",
                "value": "",
                "type": "path",
                "description": "Credential assignment identifier"
              }
            ]
          },
          "docs": "Retrieve a specific credential assignment."
        },
        {
          "info": {
            "name": "Modify a credential assignment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.targetsolutions.com/v1/credentials/:credentialid/assignments/:assignmentid",
            "params": [
              {
                "name": "credentialid",
                "value": "",
                "type": "path",
                "description": "Credential identifier"
              },
              {
                "name": "assignmentid",
                "value": "",
                "type": "path",
                "description": "Credential assignment identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify a credential assignment."
        },
        {
          "info": {
            "name": "Remove a credential assignment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.targetsolutions.com/v1/credentials/:credentialid/assignments/:assignmentid",
            "params": [
              {
                "name": "credentialid",
                "value": "",
                "type": "path",
                "description": "Credential identifier"
              },
              {
                "name": "assignmentid",
                "value": "",
                "type": "path",
                "description": "Credential assignment identifier"
              }
            ]
          },
          "docs": "Remove a credential assignment."
        }
      ]
    }
  ],
  "bundled": true
}