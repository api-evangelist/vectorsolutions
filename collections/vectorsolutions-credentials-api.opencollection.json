{
  "opencollection": "1.0.0",
  "info": {
    "name": "TargetSolutions Courses Credentials API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AccessToken",
      "value": "{{AccessToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve all credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/credentials",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "JSON search filter, e.g. q={\"key\":\"value\"} (documented in the developer portal FAQ)."
              }
            ]
          },
          "docs": "Retrieve all credentials."
        },
        {
          "info": {
            "name": "Retrieve a specific credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/credentials/:credentialid",
            "params": [
              {
                "name": "credentialid",
                "value": "",
                "type": "path",
                "description": "Credential identifier"
              }
            ]
          },
          "docs": "Retrieve a specific credential."
        },
        {
          "info": {
            "name": "Retrieve credentials in a category",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/sites/categories/credential/:categoryid/credentials",
            "params": [
              {
                "name": "categoryid",
                "value": "",
                "type": "path",
                "description": "Category identifier"
              }
            ]
          },
          "docs": "Retrieve credentials in a category."
        },
        {
          "info": {
            "name": "Retrieve site credentials in a category",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/sites/:siteid/categories/credential/:categoryid/credentials",
            "params": [
              {
                "name": "siteid",
                "value": "",
                "type": "path",
                "description": "Site identifier"
              },
              {
                "name": "categoryid",
                "value": "",
                "type": "path",
                "description": "Category identifier"
              }
            ]
          },
          "docs": "Retrieve site credentials in a category."
        }
      ]
    }
  ],
  "bundled": true
}