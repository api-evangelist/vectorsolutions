{
  "opencollection": "1.0.0",
  "info": {
    "name": "TargetSolutions Courses Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AccessToken",
      "value": "{{AccessToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve all users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/users",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "JSON search filter, e.g. q={\"key\":\"value\"} (documented in the developer portal FAQ)."
              }
            ]
          },
          "docs": "Retrieve all users."
        },
        {
          "info": {
            "name": "Retrieve all users across sites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/sites/users",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "JSON search filter, e.g. q={\"key\":\"value\"} (documented in the developer portal FAQ)."
              }
            ]
          },
          "docs": "Retrieve all users across sites."
        },
        {
          "info": {
            "name": "Retrieve users within a site",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/sites/:siteid/users",
            "params": [
              {
                "name": "siteid",
                "value": "",
                "type": "path",
                "description": "Site identifier"
              }
            ]
          },
          "docs": "Retrieve users within a site."
        },
        {
          "info": {
            "name": "Create a new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.targetsolutions.com/v1/sites/:siteid/users",
            "params": [
              {
                "name": "siteid",
                "value": "",
                "type": "path",
                "description": "Site identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new user."
        },
        {
          "info": {
            "name": "Retrieve a specific user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targetsolutions.com/v1/users/:userid",
            "params": [
              {
                "name": "userid",
                "value": "",
                "type": "path",
                "description": "User identifier"
              }
            ]
          },
          "docs": "Retrieve a specific user."
        },
        {
          "info": {
            "name": "Modify user details",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.targetsolutions.com/v1/users/:userid",
            "params": [
              {
                "name": "userid",
                "value": "",
                "type": "path",
                "description": "User identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify user details."
        }
      ]
    }
  ],
  "bundled": true
}